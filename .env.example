# Local development only. Change credentials for any shared deployment.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=learning
PGPASSWORD=learning_dev
PGDATABASE=learning
# Optional: a PostgreSQL URL overrides PG* connection parameters in the backend.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional override for generated JSON storage (default: apps/backend/data/readings).
# READING_DATA_DIR=/absolute/path/to/readings

# Corpus uploads are UTF-8, resumable in chunks up to 8 MiB.
# Default file limit: 1 GiB. Increase only after checking disk/database capacity.
CORPUS_MAX_UPLOAD_BYTES=1073741824
# Local override; Compose persists files in the corpus_data volume.
# CORPUS_DATA_DIR=/absolute/path/to/corpus
